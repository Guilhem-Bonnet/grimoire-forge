{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grimoire-forge.dev/schemas/catalogue-export/v1",
  "title": "Grimoire Forge Catalogue Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogVersion",
    "generatedAt",
    "source",
    "families",
    "patterns",
    "relations",
    "contracts"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/familyId" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "name", "intent", "problem", "solution", "docPath"],
        "properties": {
          "id": { "$ref": "#/$defs/patternId" },
          "family": { "$ref": "#/$defs/familyId" },
          "name": { "type": "string", "minLength": 1 },
          "intent": { "type": "string" },
          "problem": { "type": "string" },
          "solution": { "type": "string" },
          "controls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "antiPattern": { "type": "string" },
          "maturity": {
            "type": "string",
            "description": "Niveau issu de la matrice de maturité des patterns"
          },
          "docPath": {
            "type": "string",
            "description": "Chemin relatif + ancre vers la fiche source"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "$ref": "#/$defs/patternId" },
          "to": { "$ref": "#/$defs/patternId" },
          "kind": {
            "type": "string",
            "enum": [
              "founds",
              "depends",
              "feeds",
              "governs",
              "produces",
              "triggers",
              "extends",
              "reinforces",
              "related"
            ]
          },
          "label": {
            "type": "string",
            "description": "Verbe source de la fiche, ex. Fonde, Dépend de, Alimente"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "fields"],
        "properties": {
          "id": { "$ref": "#/$defs/contractId" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "obligation", "role"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "obligation": {
                  "type": "string",
                  "enum": ["required", "recommended", "conditional", "optional"]
                },
                "role": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "patterns": {
            "type": "array",
            "items": { "$ref": "#/$defs/patternId" }
          }
        }
      }
    },
    "antiPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "patterns": {
            "type": "array",
            "items": { "$ref": "#/$defs/patternId" }
          }
        }
      }
    }
  },
  "$defs": {
    "familyId": {
      "type": "string",
      "enum": ["ORG", "ORC", "GOV", "QUA", "KNO", "RUN", "COG", "MOD"]
    },
    "patternId": {
      "type": "string",
      "pattern": "^(ORG|ORC|GOV|QUA|KNO|RUN|COG|MOD)-\\d{2}$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
