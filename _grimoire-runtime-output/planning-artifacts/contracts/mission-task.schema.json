{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grimoire/mission-board/mission-task.schema.json",
  "title": "MissionTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec", "status", "refs"],
  "properties": {
    "apiVersion": { "const": "grimoire/v1alpha1" },
    "kind": { "const": "MissionTask" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "missionId", "origin", "createdAt", "requestId", "idempotencyKey"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "missionId": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["user", "import", "runtime", "self-heal", "verification"] },
        "createdAt": { "type": "string", "minLength": 1 },
        "requestId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "type", "priority", "complexity", "acceptanceCriteria", "evidenceProfile"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "enum": ["research", "architecture", "implementation", "incident", "documentation", "security", "asset", "ux"] },
        "labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "priority": { "enum": ["p0", "p1", "p2", "p3"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "complexity": { "enum": ["trivial", "standard", "complex", "expert"] },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "flowHint": { "type": "string", "minLength": 1 },
        "evidenceProfile": { "enum": ["light", "standard", "strict", "security_critical"] },
        "policyPack": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "bundleRef": { "type": "string", "minLength": 1 },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lane": { "type": "string", "minLength": 1 },
            "recipeRef": { "type": "string", "minLength": 1 },
            "verificationProfile": { "enum": ["light", "standard", "strict", "security_critical"] },
            "rationale": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "default": []
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "qualification", "assignment", "execution", "verification", "supervision"],
      "properties": {
        "lifecycle": { "enum": ["backlog", "ready", "in_progress", "review", "blocked", "done", "cancelled"] },
        "qualification": { "enum": ["pending", "qualified", "rejected"] },
        "assignment": { "enum": ["unassigned", "assigned", "released"] },
        "execution": { "enum": ["idle", "running", "checkpoint_due", "paused", "failed"] },
        "verification": { "enum": ["none", "queued", "verifying", "accepted", "rejected", "needs_work"] },
        "supervision": { "enum": ["healthy", "stale", "escalated", "quarantined"] }
      }
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "evidenceRefs", "sessionRefs"],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "workflowInstanceId": { "type": ["string", "null"] },
        "verificationRef": { "type": ["string", "null"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "sessionRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    }
  }
}
