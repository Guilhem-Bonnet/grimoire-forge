{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grimoire/mission-board/board-command-envelope.schema.json",
  "title": "BoardCommandEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelopeId", "commandName", "actor", "requestId", "idempotencyKey", "preview", "payload"],
  "properties": {
    "envelopeId": { "type": "string", "minLength": 1 },
    "commandName": {
      "enum": [
        "create_task",
        "qualify_task",
        "approve_route",
        "override_route",
        "start_execution",
        "record_checkpoint",
        "request_verification",
        "accept_verification",
        "reject_verification",
        "block_task",
        "unblock_task",
        "escalate_task",
        "close_task",
        "close_mission"
      ]
    },
    "taskId": { "type": "string", "minLength": 1 },
    "missionId": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "preview": { "type": "boolean" },
    "preconditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "payload": {
      "type": "object",
      "description": "Payload libre mais borne par la commande et les guards runtime"
    }
  }
}
