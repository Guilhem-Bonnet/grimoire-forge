{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grimoire/mission-board/routing-decision.schema.json",
  "title": "RoutingDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "taskId", "lane", "recipeRef", "verificationProfile", "reviewMode", "overrideable", "rationale", "inputSnapshot"],
  "properties": {
    "decisionId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "minLength": 1 },
    "recipeRef": { "type": "string", "minLength": 1 },
    "verificationProfile": { "enum": ["light", "standard", "strict", "security_critical"] },
    "reviewMode": { "enum": ["none", "inline", "strict", "security"] },
    "overrideable": { "type": "boolean" },
    "policyPack": { "type": "string", "minLength": 1 },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "inputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "complexity", "evidenceProfile"],
      "properties": {
        "type": { "enum": ["research", "architecture", "implementation", "incident", "documentation", "security", "asset", "ux"] },
        "complexity": { "enum": ["trivial", "standard", "complex", "expert"] },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "evidenceProfile": { "enum": ["light", "standard", "strict", "security_critical"] },
        "flowHint": { "type": "string", "minLength": 1 },
        "policyPack": { "type": "string", "minLength": 1 }
      }
    }
  }
}
