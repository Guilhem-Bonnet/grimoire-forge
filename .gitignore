# ═══════════════════════════════════════════════════════════════════════════════
# grimoire (meta-projet) — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# Le produit a son propre repo git — on l'exclut ici
grimoire-kit/
*etudes/

# Python
__pycache__/
*.py[cod]
*$py.class

# IDE personnel
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Legacy BMAD runtime (old branches only)
_bmad/_memory/*.json
_bmad/_memory/*.jsonl
_bmad/_memory/qdrant_cache/
qdrant_data/

# Grimoire runtime (mémoire, cache)
_grimoire/_memory/*.json
_grimoire/_memory/*.jsonl
_grimoire/_memory/qdrant_data/
_grimoire/_memory/backends/__pycache__/

# Grimoire output runtime
_grimoire-output/*
!_grimoire-output/evidence/
!_grimoire-output/evidence/**
!_grimoire-output/context/
_grimoire-output/context/*
!_grimoire-output/context/r9-hooks-skills/
!_grimoire-output/context/r9-hooks-skills/**
!_grimoire-output/context/r10-cockpit/
!_grimoire-output/context/r10-cockpit/**
!_grimoire-output/decisions/
_grimoire-output/decisions/*
!_grimoire-output/decisions/r9-hooks-skills/
!_grimoire-output/decisions/r9-hooks-skills/**
!_grimoire-output/decisions/r10-cockpit/
!_grimoire-output/decisions/r10-cockpit/**

# Mémoire runtime locale (backend lexical, index)
_grimoire/memory/

# Télémétrie runtime (streams d'événements, jamais committée)
_grimoire-runtime-output/hook-runtime/
_grimoire-runtime-output/task-flow/
_grimoire-runtime/_memory/activity.jsonl
_grimoire-runtime-output/.qdrant_data/
_grimoire-runtime-output/.event-log.jsonl
_grimoire-runtime-output/.router-stats.jsonl
_grimoire-runtime-output/GRIMOIRE_TRACE.jsonl

# pytest
.pytest_cache/
.ruff_cache/

# Playwright MCP screenshots
.playwright-mcp/
_grimoire-runtime-output/test-artifacts/playwright/

# MkDocs generated site
grimoire-kit/site/
site/

# Audit scratch pads (never commit)
.tmp-copilot-audit/
.tmp-*-audit/

# Stray shell redirects (e.g. `cmd > e` typo)
/e

# --- Grimoire Kit ---
# Session runs — ephemeral runtime data
_grimoire-output/.runs/
# Memory archives — compressed old sessions
_grimoire/_memory/archives/
