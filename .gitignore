# ═══════════════════════════════════════════════════════════════════════════════
# grimoire (meta-projet) — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# Le produit a son propre repo git — on l'exclut ici
grimoire-kit/

# Python
__pycache__/
*.py[cod]
*$py.class

# IDE personnel
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Legacy BMAD runtime (old branches only)
_bmad/_memory/*.json
_bmad/_memory/*.jsonl
_bmad/_memory/qdrant_cache/
qdrant_data/

# Grimoire runtime (mémoire, cache)
_grimoire/_memory/*.json
_grimoire/_memory/*.jsonl
_grimoire/_memory/qdrant_data/
_grimoire/_memory/backends/__pycache__/

# Grimoire output runtime
_grimoire-output/*
!_grimoire-output/evidence/
!_grimoire-output/evidence/**
!_grimoire-output/context/
!_grimoire-output/context/**
!_grimoire-output/decisions/
!_grimoire-output/decisions/**

# pytest
.pytest_cache/
.ruff_cache/

# Playwright MCP screenshots
.playwright-mcp/
_grimoire-runtime-output/test-artifacts/playwright/

# MkDocs generated site
grimoire-kit/site/
site/

# Audit scratch pads (never commit)
.tmp-copilot-audit/
.tmp-*-audit/

# Stray shell redirects (e.g. `cmd > e` typo)
/e
