{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B (local)",
          "tools": true
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B (local)",
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "grimoire": {
      "type": "local",
      "command": [
        ".codex/mcp/grimoire-mcp.sh"
      ],
      "enabled": true
    }
  }
}
