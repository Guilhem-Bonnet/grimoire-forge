    {
      "label": "grimoire: test-all",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.github/hooks/scripts/grimoire-task-flow.sh --task 'grimoire: test-all' --flow quality -- ${workspaceFolder}/grimoire-kit/.venv/bin/python -m pytest tests/ -q --tb=short -x --ignore=tests/test_background_tasks.py",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "grimoire: test-modified",
      "type": "shell",
      "command": "bash ${workspaceFolder}/.github/hooks/scripts/grimoire-task-flow.sh --task 'grimoire: test-modified' --flow quality -- bash -c 'CHANGED=$( { git diff --name-only --diff-filter=ACMR HEAD -- tests; git ls-files --others --exclude-standard -- tests; } | grep \"^tests/.*test_.*\\.py$\" | sort -u | tr \"\\n\" \" \" ); if [ -z \"$CHANGED\" ]; then echo \"Aucun test modifie.\"; else ${workspaceFolder}/grimoire-kit/.venv/bin/python -m pytest $CHANGED -q --tb=short -x; fi'",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": true
      },
      "problemMatcher": []
    },
