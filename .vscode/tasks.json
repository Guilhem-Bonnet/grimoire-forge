secret-devel/krb5-devel)\"; else echo \"  ⚠️  pkg-config absent — impossible de vérifier les libs natives\"; fi; echo \"\"; echo \"[inotify watch limit]\"; WATCHES=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo 0); if [ \"$WATCHES\" -ge 524288 ]; then echo \"  ✅ max_user_watches=$WATCHES\"; else echo \"  ❌ max_user_watches=$WATCHES (recommandé >= 524288)\"; echo \"  → echo fs.inotify.max_user_watches=524288 | sudo tee -a /etc/sysctl.conf && sudo sysctl -p\"; fi; echo \"\"; echo \"[WSL]\"; if grep -qi microsoft /proc/version 2>/dev/null; then grep -qi wsl2 /proc/version 2>/dev/null && echo \"  ✅ WSL2\" || echo \"  ❌ WSL1 détecté (non supporté pour builds VS Code)\"; else echo \"  ✅ Non-WSL\"; fi; if [ -d .devcontainer ]; then echo \"\"; echo \"[Dev Container]\"; command -v docker >/dev/null 2>&1 && echo \"  ✅ docker disponible\" || echo \"  ⚠️  .devcontainer présent mais docker absent (utiliser Codespaces ou installer Docker)\"; fi; elif [ \"$PLATFORM\" = \"Darwin\" ]; then echo \"[macOS toolchain]\"; xcode-select -p >/dev/null 2>&1 && echo \"  ✅ Xcode CLI Tools\" || echo \"  ❌ Absent — xcode-select --install\"; if command -v node >/dev/null 2>&1; then NODEV=$(node --version); NODEARCH=$(node -p process.arch 2>/dev/null || echo unknown); echo \"  ✅ Node.js $NODEV ($NODEARCH)\"; [ \"$NODEARCH\" = \"x64\" ] || [ \"$NODEARCH\" = \"arm64\" ] || echo \"  ⚠️  Architecture non recommandée (attendu: x64/arm64)\"; else echo \"  ❌ Node.js absent\"; fi; command -v python >/dev/null 2>&1 && echo \"  ✅ $(python --version 2>&1)\" || echo \"  ❌ commande python absente\"; fi; echo \"\"'",
