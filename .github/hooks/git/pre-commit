#!/usr/bin/env bash
# pre-commit — Grimoire doc-drift gate.
# Refuse un commit qui modifie un source declare blocking sans mise a jour du miroir.
#
# Installe par : .github/hooks/git/install.sh
# Bypass d'urgence : `git commit --no-verify` (a n'utiliser que sciemment).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  exit 0  # pas dans un repo git, rien a faire
fi

kit_root="$repo_root/grimoire-kit"
detector="$kit_root/framework/tools/doc-drift-detector.py"
python_bin="$kit_root/.venv/bin/python"

if [[ ! -x "$python_bin" ]]; then
  python_bin="$(command -v python3 || true)"
fi

# Fail-open si l'outil n'est pas dispo — ne bloque jamais un commit legitime
# a cause d'un environnement non setup.
if [[ -z "$python_bin" || ! -f "$detector" ]]; then
  exit 0
fi

# Liste des fichiers staged (pas de contexte de diff non staged pris en compte
# ici — git pre-commit travaille sur l'index).
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

# Normaliser les chemins relativement a grimoire-kit/ quand applicable
# (le manifeste est ancre sur le sous-projet kit).
mapped=()
for f in "${staged[@]}"; do
  if [[ "$f" == grimoire-kit/* ]]; then
    mapped+=("${f#grimoire-kit/}")
  else
    mapped+=("$f")
  fi
done

# Invoquer le detecteur en mode explicit-files (exit 2 si blocking).
set +e
output=$(cd "$kit_root" && "$python_bin" "$detector" --project-root . --files "${mapped[@]}" 2>/dev/null)
rc=$?
set -e

if [[ $rc -eq 2 ]]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "   COMMIT BLOQUE — Grimoire doc-drift (severity=blocking)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  printf '%s\n' "$output"
  echo ""
  echo "Action : stager la mise a jour des docs miroir listees ci-dessus."
  echo "Bypass (exceptionnel) : git commit --no-verify"
  echo ""
  exit 1
fi

# rc=1 (drift enforcing/info) ou rc=0 (clean) : on laisse passer, la couche
# runtime (PostToolUse hook + CI) s'en chargera.
exit 0
